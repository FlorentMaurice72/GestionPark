# Copier ce fichier en .env et renseigner les vraies valeurs (jamais commité).

# Supabase — pooler en "transaction mode" (port 6543), utilisé par l'app à l'exécution.
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — pooler en "session mode" (port 5432), utilisé par le CLI Prisma pour les migrations.
DIRECT_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Auth.js — générer avec `npx auth secret` (ou `openssl rand -base64 33`).
AUTH_SECRET=""

# Resend (https://resend.com) — pour l'email de réinitialisation de mot de
# passe admin. Tant qu'aucun domaine n'est vérifié dans Resend, EMAIL_FROM
# doit rester "onboarding@resend.dev" et l'envoi ne fonctionne que vers
# l'email du compte Resend lui-même (limite du mode test).
RESEND_API_KEY=""
EMAIL_FROM="GestionPark <onboarding@resend.dev>"
